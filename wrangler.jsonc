{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paulibaby-blog-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,

  // Cloudflare Access: set these to your Zero Trust team domain, the Access
  // application's AUD tag, and the emails allowed in each role.
  "vars": {
    "TEAM_DOMAIN": "",
    "POLICY_AUD": "",
    "ADMIN_EMAILS": "",
    "EDITOR_EMAILS": ""
  },
  
  // Default Environment (Local / Development)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paulibaby-blog",
      "database_id": "d420d8f1-bae9-4ff8-9eb8-7ceed2b2c7a2",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT",
      "bucket_name": "paulibaby-blog-content"
    },
    {
      "binding": "UPLOADS",
      "bucket_name": "paulibaby-blog-uploads"
    }
  ],

  // Worker Previews (reuses the existing bindings)
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "paulibaby-blog",
        "database_id": "d420d8f1-bae9-4ff8-9eb8-7ceed2b2c7a2",
        "migrations_dir": "migrations"
      }
    ],
    "r2_buckets": [
      { "binding": "CONTENT", "bucket_name": "paulibaby-blog-content" },
      { "binding": "UPLOADS", "bucket_name": "paulibaby-blog-uploads" }
    ]
  },

  // Production/Remote Overrides
"env": {
  "production": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "paulibaby-blog",
        "database_id": "d420d8f1-bae9-4ff8-9eb8-7ceed2b2c7a2",
        "migrations_dir": "migrations"
      }
    ],
    "r2_buckets": [
      { "binding": "CONTENT", "bucket_name": "paulibaby-blog-content" },
      { "binding": "UPLOADS", "bucket_name": "paulibaby-blog-uploads" }
    ]
  }
}

}
