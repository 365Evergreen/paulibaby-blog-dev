{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "paulibaby-blog-dev",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-23",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "paulibaby-blog",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{ "binding": "CONTENT", "bucket_name": "paulibaby-blog-content" },
		{ "binding": "UPLOADS", "bucket_name": "paulibaby-blog-uploads" }
	]
	// Secrets (`pnpm wrangler secret put <NAME>`; locally in .dev.vars): ADMIN_PASSWORD, SESSION_SECRET
}
